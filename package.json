{
  "name": "carpool",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bunx --bun vite",
    "dev:server": "bun --hot server.js",
    "dev:worker": "bunx wrangler dev",
    "build": "bunx --bun vite build",
    "lint": "eslint .",
    "preview": "bunx --bun vite preview",
    "start": "bun server.js",
    "cf:deploy": "bunx wrangler deploy",
    "cf:d1:migrate:local": "bunx wrangler d1 migrations apply carpool-db --local",
    "cf:d1:migrate:remote": "bunx wrangler d1 migrations apply carpool-db --remote"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.5",
    "wrangler": "^4.69.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "^8.0.0-beta.13"
  },
  "overrides": {
    "vite": "^8.0.0-beta.13"
  }
}
